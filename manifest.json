{
  "manifest_version": 3,
  "name": "AI Tab Organizer",
  "description": "Use AI to classify tabs and manage Chrome tab groups with preview/apply/undo workflow.",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://api.minimaxi.com/*",
    "https://www.minimaxi.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Tab Organizer"
  }
}
